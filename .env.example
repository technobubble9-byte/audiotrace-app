# Server-only secret that seeds the watermark's pseudo-random coordinate
# assignment. Anyone with this value can, in principle, work out where bits
# are hidden and strip/forge a watermark's payload, so keep it out of git
# and out of any client-visible bundle (it's only ever read in *.server.ts
# files, which TanStack Start's bundler excludes from the client build).
#
# Generate a real one with: openssl rand -hex 32
WATERMARK_SECRET=replace-this-with-a-long-random-value-before-deploying

# Optional: override where SQLite + audio files are stored on disk.
# Defaults to ./data
# AUDIOTRACE_DATA_DIR=/var/lib/audiotrace/data

# ---------------------------------------------------------------------------
# Dodo Payments (checkout + post-payment dashboard access)
# ---------------------------------------------------------------------------

# From Dodo dashboard → Developer → API Keys. NEVER commit the real value.
DODO_PAYMENTS_API_KEY=replace-with-your-dodo-secret-key

# From Dodo dashboard → Developer → Webhooks, after you register
# https://app.audiotrace.tech/api/webhooks/dodo as an endpoint there.
DODO_PAYMENTS_WEBHOOK_SECRET=replace-with-your-dodo-webhook-secret

# "test_mode" while testing, "live_mode" once you're ready for real charges.
DODO_ENVIRONMENT=test_mode

# Product IDs from Dodo dashboard → Products (one per pricing tier).
DODO_PRODUCT_ID_BASIC=replace-with-basic-tier-product-id
DODO_PRODUCT_ID_PRO=replace-with-pro-tier-product-id
DODO_PRODUCT_ID_ELITE=replace-with-elite-tier-product-id

# This app's own public URL — used to build the Dodo return_url and webhook
# registration target. No trailing slash.
PUBLIC_APP_URL=https://app.audiotrace.tech

# Comma-separated list of origins allowed to call POST /api/checkout
# cross-origin (the marketing site's "Get Standard"/"Secure Ultimate"
# buttons call this from a different domain).
MARKETING_SITE_ORIGINS=https://www.audiotrace.tech,https://audiotrace.tech

# Signs the logged-in session cookie (separate from payment status — see
# README "Payments" section for how the two checks work together).
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-this-with-a-different-long-random-value
